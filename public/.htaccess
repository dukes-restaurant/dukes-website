# Apache-Konfiguration für die statische Astro-Seite (wird beim Build nach dist/ kopiert)

# Keine Verzeichnis-Listings (ServerSignature/ServerTokens bitte beim Hoster in der Server-Konfig setzen)
Options -Indexes

# Nur statische Dateien: PHP & Co. nie ausführen, selbst wenn jemand eine Datei hochlädt
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>

# Versteckte Dateien (.git, .env, .htaccess …) sperren
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.(?!well-known)

# Alles auf HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Unbekannte URLs zeigen die 404-Seite
ErrorDocument 404 /404.html

# Alte WordPress-Unterseiten dauerhaft (301) auf die Startseiten-Abschnitte umleiten
RedirectMatch 301 ^/restaurant/?$ /#bereiche
RedirectMatch 301 ^/wochenmenue?/?$ /#wochenmenu
RedirectMatch 301 ^/lokal-mieten/?$ /#lokal-mieten
RedirectMatch 301 ^/kontakt/?$ /#lokal-mieten
RedirectMatch 301 ^/ueber-uns/?$ /
# Typische WordPress-Angriffsziele gibt es nicht mehr
RedirectMatch 410 ^/(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php)

<IfModule mod_headers.c>
  # HSTS: Browser nutzen nur noch HTTPS (aktuell steht auf dem Server max-age=0)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Clickjacking-Schutz: niemand darf dukes.ch in ein iframe einbetten
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header unset X-Powered-By

  # Gehashte Build-Dateien (CSS/JS/Fonts) lange cachen, HTML immer frisch laden
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
