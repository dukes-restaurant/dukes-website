---
import { Image } from 'astro:assets';
import { nav, contact, bookingUrl } from '../data/nav';
---
<footer class="bg-ink text-cream/80">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 md:grid-cols-3">
    <div>
      <Image src="/brand/dukes-logo.png" alt="dukes" width="768" height="371" class="h-16 w-auto brightness-0 invert" loading="lazy" />
      <p class="mt-4 text-sm">Restaurant, Partylokal sihl3</p>
      <address class="mt-2 text-sm not-italic">
        {contact.company}<br />{contact.street}<br />{contact.city}
      </address>
      <p class="mt-3 flex gap-4 text-sm">
        <a class="hover:text-gold underline underline-offset-4" href={contact.facebook} rel="noopener">Facebook</a>
        <a class="hover:text-gold underline underline-offset-4" href={contact.instagram} rel="noopener">Instagram</a>
      </p>
    </div>
    <div>
      <h3 class="text-gold text-lg">Öffnungszeiten</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li class="flex justify-between gap-4"><span>Restaurant</span><span>MO–FR 08:00–14:00</span></li>
        <li class="flex justify-between gap-4"><span>Abendservice</span><span>MI–SA ab 18:00</span></li>
        <li class="flex justify-between gap-4"><span>Club</span><span>MI–SO ab 20:00</span></li>
        <li class="flex justify-between gap-4"><span>Fonduestübli</span><span>FR/SA ab 18:00</span></li>
      </ul>
    </div>
    <div>
      <h3 class="text-gold text-lg">Reservation</h3>
      <!-- <a href={bookingUrl} data-reserve target="_blank" class="mt-3 inline-block rounded-full bg-gold px-5 py-2 text-sm font-semibold text-ink hover:bg-cream">Online reservieren</a> -->
      <p class="mt-3 text-sm"><a class="hover:text-gold text-lg font-semibold text-cream" href={contact.phoneHref}>{contact.phone}</a></p>
      <p class="text-sm"><a class="hover:text-gold underline underline-offset-4" href={`mailto:${contact.email}`}>{contact.email}</a></p>
      <p class="mt-3 text-xs text-cream/70">Anfragen werden bis 10:00 des Tages bearbeitet und nur per E-Mail bestätigt.</p>
    </div>
  </div>
  <div class="border-t border-white/10 px-5 py-5 text-center text-xs text-cream/60">
    <nav class="mb-2 flex flex-wrap justify-center gap-x-5 gap-y-1">
      {nav.map((n) => <a href={n.href} class="hover:text-gold">{n.label}</a>)}
    </nav>
    © {new Date().getFullYear()} {contact.company}, Sihlbrugg
  </div>
</footer>
