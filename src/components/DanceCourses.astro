---
const courses: { title: string; when: string; price: string; area: string; image: string }[] = [
  { title: "Boogie Woogie Tanzkurs", when: 'Jeden Mi - 19:45-20:45', price: 'Eintritt frei', area: 'Dukes Saal', image: '/events/tanz-crash-kurs-2026-new-im-dukes-saal.webp' },
  { title: 'Line Dance mit Crash-Kurs', when: 'Jeden Fr - Kurs 19:15, Party ab 20:30', price: 'Crash-Kurs gratis', area: 'Dukes Club', image: '/events/line-dance-mit-doris-2.webp' },
  { title: 'Disco-Fox Tanzkurs (5 Abende)', when: 'Siehe flyer', price: 'CHF 100', area: 'Dukes Club', image: '/events/discofox-november-2026.jpg' },
  { title: 'Catalan Line Dance Workshops', when: 'Ausgewählte Montage ab 19:00', price: 'CHF 10–25 \n nur mit Anmeldung', area: 'Dukes', image: '/events/catalan-linedance-workshop.png' },
];

const card = 'aspect-[1/1.414] overflow-hidden rounded-lg bg-wood shadow-lg ring-rust ring-offset-2 ring-offset-cream transition duration-300';
---
<section id="tanzkurse" aria-labelledby="tanzkurse-title" class="scroll-mt-20 bg-cream border-t border-bark/10">
  <div class="mx-auto max-w-7xl px-5 py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.15em] text-rust">Kurse &amp; Workshops</p>
    <h2 class="mt-2 text-4xl sm:text-5xl">Tanzkurse</h2>

    <ul class="mt-8 flex flex-wrap justify-center gap-4 sm:gap-8 md:gap-16 lg:gap-24">
      {courses.map((c) => {
        const text = (
          <>
            <p class="mt-2 whitespace-pre-line text-xs font-semibold uppercase text-rust sm:text-sm">{c.when}</p>
            <p class="line-clamp-2 whitespace-pre-line font-display text-sm leading-tight text-bark group-hover:text-rust sm:text-lg text-break">{c.title}</p>
            <p class="whitespace-pre-line text-xs text-bark/70 sm:text-sm">{c.area}</p>
            {c.price && <p class="whitespace-pre-line text-xs text-bark/70 sm:text-sm text-break">{c.price}</p>}
          </>
        );
        return (
          <li class="w-[calc((100%-1rem)/2)] sm:w-48">
            {c.image ? (
              <a href={c.image} data-flyer={`Flyer ${c.title}`} target="_blank" rel="noopener" class="group block focus-visible:outline-none">
                <div class={`${card} group-hover:-translate-y-1.5 group-hover:shadow-2xl group-focus-visible:ring-2`}>
                  <img src={c.image} alt={`Flyer ${c.title}`} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                </div>
                {text}
              </a>
            ) : (
              <div>
                <div class={`${card} flex items-center justify-center p-3 text-center font-display text-cream/60 sm:text-xl`}>{c.title}</div>
                {text}
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>
