---
import { nav, bookingUrl } from '../data/nav';
const path = Astro.url.pathname;

// START bleibt auf der ganzen Startseite aktiv (auch bei /#wochenmenu usw.),
// Unterseiten werden über ihren Pfad bzw. `match` hervorgehoben.
const isActive = (n: (typeof nav)[number]) => {
  if (n.href === '/' || n.href === '/#') return path === '/';
  if (n.match) return path.startsWith(n.match);
  return !n.href.includes('#') && path.startsWith(n.href);
};
---
<header class="sticky top-0 z-50 bg-ink/95 backdrop-blur border-b border-gold/20">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-2">
    <a href="/" aria-label="dukes – Start" class="shrink-0">
      <!-- Original-Logo ist schwarz; per Filter weiss auf dem dunklen Header -->
      <img src="/brand/dukes-logo.png" alt="dukes – essen, trinken, tanzen" width="768" height="371" class="h-12 w-auto brightness-0 invert" />
    </a>
    <nav class="hidden lg:flex gap-7" aria-label="Hauptnavigation">
      {nav.map((n) => (
        <a href={n.href} class:list={['text-xs font-semibold tracking-widest py-2 border-b-2 transition-colors hover:text-gold', isActive(n) ? 'text-gold border-gold' : 'text-cream/80 border-transparent']}>{n.label}</a>
      ))}
    </nav>
    <a href=/#lokal-mieten class="hidden lg:inline-block rounded-full bg-gold px-4 py-2 text-xs font-bold tracking-widest text-ink hover:bg-cream">RESERVIEREN</a>
    <div class="flex items-center gap-2 lg:hidden">
      <a href=/#lokal-mieten class="rounded-full bg-gold px-4 py-2 text-xs font-bold tracking-widest text-ink hover:bg-cream">RESERVIEREN</a>
      <button id="menu-btn" class="text-cream p-2" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-nav">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hidden lg:hidden border-t border-gold/20 bg-ink px-5 pb-4" aria-label="Mobile Navigation">
    {nav.map((n) => (
      <a href={n.href} class:list={['block py-3 text-sm font-semibold tracking-widest border-b border-white/5', isActive(n) ? 'text-gold' : 'text-cream/85']}>{n.label}</a>
    ))}
  </nav>
</header>
<script>
  const b = document.getElementById('menu-btn')!;
  const m = document.getElementById('mobile-nav')!;
  const set = (open: boolean) => { m.classList.toggle('hidden', !open); b.setAttribute('aria-expanded', String(open)); };
  b.addEventListener('click', () => set(m.classList.contains('hidden')));
  // Anker-Links (/#wochenmenu) schliessen das Menü
  m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
</script>
