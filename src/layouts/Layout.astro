---
import '@fontsource-variable/inter';
import '@fontsource/zilla-slab/600.css';
import '@fontsource/zilla-slab/700.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ReservationDialog from '../components/ReservationDialog.astro';
import FlyerDialog from '../components/FlyerDialog.astro';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; jsonLd?: object[] }
const {
  title = 'Dukes Restaurant Sihlbrugg – Steak, Saloon & Club',
  description = 'Restaurant, Saloon, Eventsaal und Club in Sihlbrugg (Hirzel ZH): Mittagsmenü, Steaks, Tanzparties und Tanzkurse. Lokal mieten. Reservation 043 244 40 40.',
  image = '/images/bar_compressed.jpeg',
  noindex = false,
  jsonLd = [],
} = Astro.props;
const site = Astro.site ?? new URL('https://dukes.ch');
const ogImage = new URL(image, site).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://dukes.ch').href;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dukes Restaurant" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="google-site-verification" content="ixUQuN_uvhk3ghuIcupFaqbbxbRZ6_0Ven5k1tMvs3Q" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-gold focus:p-3">Zum Inhalt</a>
    <Navbar />
    <main id="main"><slot /></main>
    <Footer />
    <!-- <ReservationDialog /> -->
    <FlyerDialog />
  </body>
</html>
