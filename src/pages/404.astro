---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Seite nicht gefunden – Dukes Restaurant">
  <section class="bg-ink px-5 py-24 text-center text-cream">
    <p class="text-gold text-6xl sm:text-8xl font-bold">404</p>
    <h1 class="mt-4 text-3xl sm:text-4xl">Diese Seite gibt es nicht mehr</h1>
    <p class="mx-auto mt-4 max-w-xl">Der Link ist veraltet oder falsch. Hier geht es weiter:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="bg-gold px-6 py-3 font-semibold text-ink">Zur Startseite</a>
      <a href="/veranstaltungen" class="border border-gold px-6 py-3 font-semibold text-gold">Veranstaltungen</a>
    </div>
  </section>
</Layout>
