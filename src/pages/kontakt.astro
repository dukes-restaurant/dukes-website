---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { contact, bookingUrl } from '../data/nav';
---
<Layout title="Kontakt – dukes">
  <PageHeader eyebrow="Wir freuen uns auf Sie" title="Kontakt" intro="Reservation, Anfragen und Anfahrt." />
  <section class="mx-auto grid max-w-5xl gap-6 px-5 py-16 md:grid-cols-3">
    <div class="rounded-2xl bg-sand p-6">
      <h2 class="text-2xl">Reservation</h2>
      <!-- <a href={bookingUrl} data-reserve target="_blank" class="mt-3 inline-block rounded-full bg-ink px-6 py-2.5 font-semibold text-cream hover:bg-rust">Online reservieren</a> -->
      <p class="mt-3"><a class="text-lg font-semibold hover:text-rust" href={contact.phoneHref}>{contact.phone}</a></p>
      <p><a class="underline hover:text-rust" href={`mailto:${contact.email}`}>{contact.email}</a></p>
      <p class="mt-3 text-sm text-bark/70">Anfragen werden bis 10:00 des Tages bearbeitet, Bestätigung nur per E-Mail.</p>
    </div>
    <div class="rounded-2xl bg-sand p-6">
      <h2 class="text-2xl">Öffnungszeiten</h2>
      <ul class="mt-3 space-y-1 text-sm">
        <li>Restaurant: MO–FR 08:00–14:00</li>
        <li>Abend: MI–SA ab 18:00</li>
        <li>Club: MI–SO ab 20:00</li>
        <li>Fonduestübli: FR/SA ab 18:00</li>
      </ul>
    </div>
    <div class="rounded-2xl bg-sand p-6">
      <h2 class="text-2xl">Adresse</h2>
      <address class="mt-3 not-italic">{contact.company}<br />{contact.street}<br />{contact.city}</address>
      <p class="mt-2 text-sm text-bark/70">Parkplätze direkt vor dem Haus.</p>
      <a href={contact.maps} target="_blank" rel="noopener" class="mt-3 inline-block font-semibold text-rust hover:underline">Route planen →</a>
      <p class="mt-3 flex gap-4 text-sm">
        <a class="underline hover:text-rust" href={contact.facebook} rel="noopener">Facebook</a>
        <a class="underline hover:text-rust" href={contact.instagram} rel="noopener">Instagram</a>
      </p>
    </div>
  </section>
</Layout>
